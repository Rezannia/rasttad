@{
    ViewData["Title"] = "درخواست شما ثبت شد";
}

@section Styles {
    <style>
        body {
            font-family: 'Vazirmatn', sans-serif;
            background: linear-gradient(135deg, #f0f7ff 0%, #ffffff 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }

        .thank-you-card {
            background: #fff;
            border-radius: 20px;
            padding: 60px 40px;
            text-align: center;
            max-width: 500px;
            width: 100%;
            box-shadow: 0 20px 50px rgba(0, 74, 153, 0.1);
        }

        .check-icon {
            width: 80px;
            height: 80px;
            background: #10b981;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 30px;
            font-size: 2.5rem;
            color: #fff;
            animation: scaleIn 0.5s ease-out;
        }

        @@keyframes scaleIn {
            0% { transform: scale(0); }
            100% { transform: scale(1); }
        }

        h1 {
            font-size: 1.8rem;
            color: #004a99;
            margin-bottom: 15px;
        }

        p {
            font-size: 1rem;
            color: #64748b;
            line-height: 1.8;
            margin-bottom: 30px;
        }

        .btn {
            display: inline-block;
            padding: 14px 40px;
            background: #004a99;
            color: #fff;
            text-decoration: none;
            border-radius: 25px;
            font-weight: 700;
            transition: all 0.2s;
        }

        .btn:hover {
            background: #003366;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 74, 153, 0.3);
        }
    </style>
}

<div class="thank-you-card">
    <div class="check-icon">✓</div>
    <h1>درخواست شما با موفقیت ثبت شد!</h1>
    <p>کارشناسان رستاد در اسرع وقت با شما تماس خواهند گرفت. از اعتماد شما سپاسگزاریم.</p>
    <a href="/" class="btn">بازگشت به صفحه اصلی</a>
</div>