@model Rasttad.Models.Industry

@{
    ViewData["Title"] = Model.MetaTitle ?? $"منابع انسانی {Model.Name} | رستاد";
    ViewData["MetaDescription"] = Model.MetaDescription ?? Model.Description;
    ViewData["MetaKeywords"] = Model.MetaKeywords;
}

@section Styles {
    <style>
        .page-hero {
            background: var(--rasttad-primary-light);
            padding: 4rem 0 3rem;
            border-bottom: 1px solid #e0e0e0;
        }

        .breadcrumb {
            font-size: 0.85rem;
            color: #6f6f6f;
            margin-bottom: 1.25rem;
        }

        .breadcrumb a {
            color: #6f6f6f;
            text-decoration: none;
        }

        .breadcrumb a:hover {
            color: var(--rasttad-primary);
        }

        .page-hero h1 {
            font-size: clamp(1.6rem, 4vw, 2.25rem);
            font-weight: 700;
            color: #1b1b1b;
            margin-bottom: 1rem;
            line-height: 1.3;
        }

        .page-hero p {
            font-size: 1.05rem;
            color: #525252;
            max-width: 720px;
            line-height: 1.8;
        }

        .summary-bar {
            background: #ffffff;
            border-bottom: 1px solid #e0e0e0;
            padding: 1.25rem 0;
        }

        .summary-bar-inner {
            display: flex;
            gap: 3rem;
            flex-wrap: wrap;
        }

        .summary-item {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .summary-item .label {
            font-size: 0.75rem;
            color: #6f6f6f;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .summary-item .value {
            font-size: 0.95rem;
            font-weight: 600;
            color: #1b1b1b;
        }

        .content-section {
            padding: 4.5rem 0;
            border-bottom: 1px solid #e0e0e0;
        }

        .content-section:last-of-type {
            border-bottom: none;
        }

        .content-section h2 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1b1b1b;
            margin-bottom: 0.75rem;
        }

        .content-section .section-desc {
            font-size: 0.95rem;
            color: #6f6f6f;
            margin-bottom: 2.5rem;
            max-width: 600px;
        }

        .card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.5rem;
        }

        .info-card {
            background: #ffffff;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 1.875rem 1.75rem;
            transition: border-color 0.2s;
        }

        .info-card:hover {
            border-color: var(--rasttad-primary);
        }

        .info-card .card-icon {
            width: 40px;
            height: 40px;
            border-radius: 4px;
            background: var(--rasttad-primary-light);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.25rem;
        }

        .info-card .card-icon svg {
            width: 20px;
            height: 20px;
            stroke: var(--rasttad-primary);
        }

        .info-card h3 {
            font-size: 1.05rem;
            font-weight: 600;
            color: #1b1b1b;
            margin-bottom: 0.625rem;
        }

        .info-card p {
            font-size: 0.9rem;
            color: #525252;
            line-height: 1.7;
        }

        .case-study {
            background: #f4f4f4;
            border-radius: 8px;
            padding: 2.5rem;
            border-right: 4px solid var(--rasttad-primary);
            margin-bottom: 1.25rem;
        }

        .case-study h3 {
            font-size: 1.15rem;
            font-weight: 700;
            color: #1b1b1b;
            margin-bottom: 0.75rem;
        }

        .case-study p {
            font-size: 0.95rem;
            color: #525252;
            margin-bottom: 1.25rem;
            line-height: 1.8;
        }

        .case-study .result {
            display: inline-block;
            background: var(--rasttad-primary);
            color: #ffffff;
            padding: 0.5rem 1.25rem;
            border-radius: 4px;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .contact-section {
            background: #f4f4f4;
            padding: 4.5rem 0;
        }

        .contact-inner {
            max-width: 700px;
            margin: 0 auto;
        }

        .contact-inner h2 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1b1b1b;
            margin-bottom: 0.75rem;
            text-align: center;
        }

        .contact-inner .subtitle {
            text-align: center;
            color: #6f6f6f;
            margin-bottom: 2.5rem;
            font-size: 0.95rem;
        }

        .contact-form {
            background: #ffffff;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 2.5rem;
        }

        .form-row-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.25rem;
            margin-bottom: 1.25rem;
        }

        .form-field {
            display: flex;
            flex-direction: column;
        }

        .form-field label {
            font-size: 0.85rem;
            font-weight: 500;
            color: #1b1b1b;
            margin-bottom: 0.5rem;
        }

        .form-field input,
        .form-field textarea {
            padding: 0.75rem 1rem;
            font-family: 'Vazirmatn', sans-serif;
            font-size: 0.9rem;
            color: #1b1b1b;
            background: #ffffff;
            border: 1px solid #c6c6c6;
            border-radius: 4px;
            outline: none;
            transition: border-color 0.2s;
            direction: rtl;
        }

        .form-field input:focus,
        .form-field textarea:focus {
            border-color: var(--rasttad-primary);
            box-shadow: 0 0 0 2px var(--rasttad-primary-light);
        }

        .form-field textarea {
            resize: vertical;
            min-height: 110px;
        }

        .form-field.full {
            margin-bottom: 1.25rem;
        }

        .submit-btn {
            width: 100%;
            padding: 0.875rem;
            background: var(--rasttad-primary);
            color: #ffffff;
            border: none;
            border-radius: 4px;
            font-family: 'Vazirmatn', sans-serif;
            font-size: 0.95rem;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s;
        }

        .submit-btn:hover {
            background: var(--rasttad-primary-dark);
        }

        @@media (max-width: 768px) {
            .content-section { padding: 3rem 0; }
            .page-hero { padding: 2.5rem 0 2rem; }
            .summary-bar-inner { gap: 1.5rem; }
            .contact-form { padding: 1.5rem 1.25rem; }
            .form-row-2 { grid-template-columns: 1fr; }
            .case-study { padding: 1.5rem 1.25rem; }
        }
    </style>
}

<!-- Hero -->
<section class="page-hero">
    <div class="grid-container">
        <div class="breadcrumb">
            <a href="/">رستاد</a> / <a href="/">صنایع</a> / <span>@Model.Name</span>
        </div>
        <h1>راهکارهای منابع انسانی برای @Model.Name</h1>
        <p>@Model.Description</p>
    </div>
</section>

<!-- Summary -->
<div class="summary-bar">
    <div class="grid-container">
        <div class="summary-bar-inner">
            <div class="summary-item">
                <div class="label">صنعت</div>
                <div class="value">@Model.Name</div>
            </div>
            <div class="summary-item">
                <div class="label">تعداد کارکنان</div>
                <div class="value">@ViewData["Employees"]</div>
            </div>
            <div class="summary-item">
                <div class="label">محل فعالیت</div>
                <div class="value">@ViewData["Location"]</div>
            </div>
        </div>
    </div>
</div>

<!-- Challenges -->
@if (Model.Challenges.Any())
{
    <section class="content-section">
        <div class="grid-container">
            <h2>چالش‌های @Model.Name</h2>
            <p class="section-desc">چالش‌های کلیدی که کسب‌وکار شما با آن روبروست.</p>
            <div class="card-grid">
                @foreach (var challenge in Model.Challenges)
                {
                    <div class="info-card">
                        <div class="card-icon">
                            <svg fill="none" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                            </svg>
                        </div>
                        <h3>@challenge.Title</h3>
                        <p>@challenge.Description</p>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Services -->
@if (Model.Services.Any())
{
    <section class="content-section">
        <div class="grid-container">
            <h2>راهکارهای رستاد</h2>
            <p class="section-desc">خدمات تخصصی ما برای حل چالش‌های @Model.Name.</p>
            <div class="card-grid">
                @foreach (var service in Model.Services)
                {
                    <div class="info-card">
                        <div class="card-icon">
                            <svg fill="none" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <h3>@service.Title</h3>
                        <p>@service.Description</p>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Case Studies -->
@if (Model.CaseStudies.Any())
{
    <section class="content-section">
        <div class="grid-container">
            <h2>نمونه‌های موفقیت</h2>
            <p class="section-desc">نتایج واقعی که برای مشتریانمان ساخته‌ایم.</p>
            @foreach (var cs in Model.CaseStudies)
            {
                <div class="case-study">
                    <h3>@cs.Title</h3>
                    <p>@cs.Description</p>
                    @if (!string.IsNullOrEmpty(cs.Result))
                    {
                        <div class="result">@cs.Result</div>
                    }
                </div>
            }
        </div>
    </section>
}

<!-- Contact -->
<section class="contact-section" id="contact">
    <div class="grid-container">
        <div class="contact-inner">
            <h2>درخواست مشاوره تخصصی</h2>
            <p class="subtitle">اطلاعات خود را وارد کنید تا کارشناسان ما با شما تماس بگیرند.</p>

            <form method="post" action="/Industry/SubmitLead" class="contact-form">
                <input type="hidden" name="IndustrySlug" value="@Model.Slug" />
                <input type="hidden" name="EmployeeCount" value="@ViewData["Employees"]" />
                <input type="hidden" name="Location" value="@ViewData["Location"]" />

                <div class="form-row-2">
                    <div class="form-field">
                        <label for="FullName">نام و نام خانوادگی *</label>
                        <input type="text" id="FullName" name="FullName" required />
                    </div>
                    <div class="form-field">
                        <label for="Phone">شماره تماس *</label>
                        <input type="tel" id="Phone" name="Phone" required />
                    </div>
                </div>

                <div class="form-field full">
                    <label for="Email">ایمیل (اختیاری)</label>
                    <input type="email" id="Email" name="Email" />
                </div>

                <div class="form-field full">
                    <label for="Message">توضیحات (اختیاری)</label>
                    <textarea id="Message" name="Message" placeholder="اگر نیاز خاصی دارید، اینجا بنویسید..."></textarea>
                </div>

                <button type="submit" class="submit-btn">ارسال درخواست</button>
            </form>
        </div>
    </div>
</section>