@{
    ViewData["Title"] = "صفحه پیدا نشد";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .error-container {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 70vh;
            padding: 20px;
        }

        .error-content {
            text-align: center;
            max-width: 500px;
        }

        .error-code {
            font-size: 7rem;
            font-weight: 700;
            color: #004a99;
            line-height: 1;
            margin-bottom: 20px;
            opacity: 0.15;
        }

        .error-content h1 {
            font-size: 1.8rem;
            color: #1e293b;
            margin-bottom: 15px;
        }

        .error-content p {
            color: #64748b;
            margin-bottom: 30px;
            line-height: 1.8;
            font-size: 1rem;
        }

        .btn-home {
            display: inline-block;
            padding: 14px 40px;
            background: #004a99;
            color: #fff;
            text-decoration: none;
            border-radius: 25px;
            font-weight: 700;
            transition: all 0.2s;
        }

        .btn-home:hover {
            background: #003366;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,74,153,0.3);
        }
    </style>
}

<div class="error-container">
    <div class="error-content">
        <div class="error-code">۴۰۴</div>
        <h1>صفحه مورد نظر پیدا نشد</h1>
        <p>
            متأسفانه صفحه‌ای که به دنبال آن هستید وجود ندارد یا حذف شده است.
            لطفاً به صفحه اصلی بازگردید.
        </p>
        <a href="/" class="btn-home">بازگشت به صفحه اصلی</a>
    </div>
</div>