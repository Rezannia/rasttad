<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="رستاد، سرای توسعه انسانی. ارائه راهکارهای تخصصی منابع انسانی برای صنایع مختلف ایران." />
    <meta name="keywords" content="منابع انسانی, مشاوره HR, رستاد, توسعه انسانی, مدیریت منابع انسانی" />
    <meta name="author" content="رستاد" />
    
    <!-- Open Graph -->
    <meta property="og:title" content="@ViewData["Title"] - رستاد" />
    <meta property="og:description" content="راهکارهای تخصصی منابع انسانی متناسب با صنعت شما" />
    <meta property="og:type" content="website" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    
    <title>@ViewData["Title"] - رستاد</title>
    
    <!-- فونت وزیرمتن (جایگزین فونت‌های USWDS برای فارسی) -->
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- USWDS CSS -->
    <link rel="stylesheet" href="~/lib/uswds/css/uswds.min.css" />
    
    <!-- USWDS Initializer -->
    <script src="~/lib/uswds/js/uswds-init.min.js"></script>
    
    <!-- RTL Override برای فارسی -->
    <link rel="stylesheet" href="~/css/rasttad-rtl.css" asp-append-version="true" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="bg-base-darkest text-white padding-y-1 padding-x-3">
            <div class="grid-container display-flex flex-justify flex-align-center">
                <a href="/" class="text-white text-bold text-no-underline">رستاد</a>
                <div class="display-flex flex-align-center gap-3">
                    <a href="/Admin" class="text-white text-no-underline">پنل مدیریت</a>
                    <span class="text-base-lightest font-sans-3xs">@User.Identity.Name</span>
                    <a href="/Home/Logout" class="text-white text-no-underline">خروج</a>
                </div>
            </div>
        </div>
    }

    @RenderBody()

    <footer class="bg-base-lightest border-top border-base-lighter margin-top-8 padding-y-6">
        <div class="grid-container">
            <div class="grid-row grid-gap-4">
                <div class="tablet:grid-col-4">
                    <h4 class="font-sans-sm text-bold margin-bottom-2">رستاد</h4>
                    <p class="font-sans-2xs text-base-dark line-height-sans-4">
                        سرای توسعه انسانی، ارائه‌دهنده راهکارهای تخصصی منابع انسانی برای صنایع مختلف ایران.
                    </p>
                </div>
                <div class="tablet:grid-col-2">
                    <h4 class="font-sans-sm text-bold margin-bottom-2">خدمات</h4>
                    <ul class="usa-list usa-list--unstyled font-sans-2xs">
                        <li><a href="/" class="text-base-dark">مشاوره منابع انسانی</a></li>
                        <li><a href="/" class="text-base-dark">جذب و استخدام</a></li>
                        <li><a href="/" class="text-base-dark">آموزش و توسعه</a></li>
                    </ul>
                </div>
                <div class="tablet:grid-col-2">
                    <h4 class="font-sans-sm text-bold margin-bottom-2">صنایع</h4>
                    <ul class="usa-list usa-list--unstyled font-sans-2xs">
                        <li><a href="/Industry/Details?slug=it" class="text-base-dark">فناوری اطلاعات</a></li>
                        <li><a href="/Industry/Details?slug=manufacturing" class="text-base-dark">تولید و صنایع</a></li>
                        <li><a href="/Industry/Details?slug=retail" class="text-base-dark">خرده‌فروشی</a></li>
                    </ul>
                </div>
                <div class="tablet:grid-col-2">
                    <h4 class="font-sans-sm text-bold margin-bottom-2">ارتباط</h4>
                    <ul class="usa-list usa-list--unstyled font-sans-2xs">
                        <li><a href="/" class="text-base-dark">درباره ما</a></li>
                        <li><a href="/" class="text-base-dark">تماس با ما</a></li>
                        <li><a href="/" class="text-base-dark">وبلاگ</a></li>
                    </ul>
                </div>
            </div>
            <div class="border-top border-base-lighter margin-top-4 padding-top-3 text-center font-sans-3xs text-base">
                © ۱۴۰۴ رستاد | تمامی حقوق محفوظ است.
            </div>
        </div>
    </footer>

    <!-- USWDS JS -->
    <script src="~/lib/uswds/js/uswds.min.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>