@model List<Rasttad.Models.Lead>

@{
    ViewData["Title"] = "مدیریت سرنخ‌ها";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .admin-container {
            max-width: 1300px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .page-header h1 {
            font-size: 1.8rem;
            color: #004a99;
        }

        .search-box {
            display: flex;
            gap: 10px;
            flex: 1;
            max-width: 500px;
        }

        .search-box input {
            flex: 1;
            padding: 12px 18px;
            font-family: inherit;
            font-size: 0.95rem;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            outline: none;
        }

        .search-box input:focus {
            border-color: #004a99;
            box-shadow: 0 0 0 3px rgba(0,74,153,0.1);
        }

        .search-box button {
            padding: 12px 25px;
            background: #004a99;
            color: #fff;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-family: inherit;
            font-weight: 500;
            transition: background 0.2s;
        }

        .search-box button:hover {
            background: #003366;
        }

        .table-container {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            overflow: hidden;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead {
            background: #f8fafc;
        }

        th {
            padding: 18px 15px;
            text-align: right;
            font-size: 0.9rem;
            font-weight: 600;
            color: #475569;
            border-bottom: 1px solid #e2e8f0;
        }

        td {
            padding: 16px 15px;
            font-size: 0.95rem;
            color: #1e293b;
            border-bottom: 1px solid #f1f5f9;
        }

        tr:hover {
            background: #f8fafc;
        }

        tr.followed-up {
            background: #f0fdf4;
        }

        .badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 0.8rem;
            font-weight: 500;
        }

        .badge-industry {
            background: #dbeafe;
            color: #1e40af;
        }

        .badge-followed {
            background: #dcfce7;
            color: #166534;
        }

        .badge-pending {
            background: #fef3c7;
            color: #92400e;
        }

        .actions {
            display: flex;
            gap: 8px;
        }

        .btn-action {
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 0.85rem;
            border: none;
            cursor: pointer;
            font-family: inherit;
            text-decoration: none;
            display: inline-block;
            transition: all 0.2s;
        }

        .btn-view {
            background: #004a99;
            color: #fff;
        }

        .btn-view:hover {
            background: #003366;
        }

        .btn-follow {
            background: #10b981;
            color: #fff;
        }

        .btn-follow:hover {
            background: #059669;
        }

        .btn-delete {
            background: #ef4444;
            color: #fff;
        }

        .btn-delete:hover {
            background: #dc2626;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #64748b;
        }

        .empty-state .icon {
            font-size: 3rem;
            margin-bottom: 15px;
        }
    </style>
}

<div class="admin-container">
    <div class="page-header">
        <h1>مدیریت سرنخ‌ها (@Model.Count)</h1>
        <form method="get" class="search-box">
            <input type="text" name="search" placeholder="جستجو بر اساس نام، شماره، ایمیل..." value="@ViewBag.SearchTerm" />
            <button type="submit">جستجو</button>
        </form>
    </div>

    @if (Model.Any())
    {
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>نام</th>
                        <th>شماره تماس</th>
                        <th>ایمیل</th>
                        <th>صنعت</th>
                        <th>تعداد کارکنان</th>
                        <th>محل</th>
                        <th>وضعیت</th>
                        <th>تاریخ</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lead in Model)
                    {
                        <tr class="@(lead.IsFollowedUp ? "followed-up" : "")">
                            <td>@lead.Id</td>
                            <td>@lead.FullName</td>
                            <td>@lead.Phone</td>
                            <td>@(lead.Email ?? "-")</td>
                            <td><span class="badge badge-industry">@lead.IndustrySlug</span></td>
                            <td>@lead.EmployeeCount</td>
                            <td>@lead.Location</td>
                            <td>
                                @if (lead.IsFollowedUp)
                                {
                                    <span class="badge badge-followed">پیگیری شده</span>
                                }
                                else
                                {
                                    <span class="badge badge-pending">در انتظار</span>
                                }
                            </td>
                            <td>@lead.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td>
                                <div class="actions">
                                    <a href="/Admin/LeadDetails/@lead.Id" class="btn-action btn-view">مشاهده</a>
                                    <form method="post" action="/Admin/ToggleFollowUp/@lead.Id" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-action btn-follow">
                                            @(lead.IsFollowedUp ? "لغو" : "پیگیری")
                                        </button>
                                    </form>
                                    <form method="post" action="/Admin/DeleteLead/@lead.Id" style="display:inline;" onsubmit="return confirm('مطمئن هستید؟');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-action btn-delete">حذف</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="icon">📭</div>
            <h3>هیچ سرنخی یافت نشد</h3>
            <p>هنوز کسی فرم درخواست مشاوره را پر نکرده است.</p>
        </div>
    }
</div>