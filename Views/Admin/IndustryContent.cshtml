@model Rasttad.Models.Industry

@{
    ViewData["Title"] = "مدیریت محتوای " + Model.Name;
    Layout = "_Layout";
}

@section Styles {
    <style>
        .admin-page {
            max-width: 1200px;
            margin: 3rem auto;
            padding: 0 1.25rem;
        }

        .page-header {
            padding: 2rem;
            border-radius: 8px;
            margin-bottom: 2rem;
            color: #ffffff;
        }

        .page-header h1 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .page-header p {
            opacity: 0.9;
            font-size: 0.9rem;
        }

        .section-card {
            background: #ffffff;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            margin-bottom: 1.5rem;
            overflow: hidden;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.25rem 1.5rem;
            background: #f8f9fa;
            border-bottom: 1px solid #e0e0e0;
        }

        .section-header h2 {
            font-size: 1.15rem;
            font-weight: 600;
            color: #1b1b1b;
        }

        .btn-add {
            padding: 0.5rem 1.25rem;
            background: #198038;
            color: #ffffff;
            text-decoration: none;
            border-radius: 4px;
            font-size: 0.85rem;
            font-weight: 500;
            transition: background 0.2s;
        }

        .btn-add:hover {
            background: #135c28;
        }

        .section-body {
            padding: 1.25rem 1.5rem;
        }

        .item-list {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 1.25rem;
            background: #f8f9fa;
            border-radius: 4px;
            border-right: 4px solid var(--rasttad-primary);
        }

        .item-info h4 {
            font-size: 1rem;
            color: #1b1b1b;
            margin-bottom: 0.25rem;
            font-weight: 600;
        }

        .item-info p {
            font-size: 0.85rem;
            color: #6f6f6f;
        }

        .item-actions {
            display: flex;
            gap: 0.5rem;
        }

        .btn-small {
            padding: 0.4rem 0.9rem;
            border-radius: 4px;
            font-size: 0.8rem;
            border: none;
            cursor: pointer;
            font-family: 'Vazirmatn', sans-serif;
            text-decoration: none;
            transition: all 0.2s;
            font-weight: 500;
        }

        .btn-edit-sm {
            background: var(--rasttad-primary);
            color: #ffffff;
        }

        .btn-edit-sm:hover {
            background: var(--rasttad-primary-dark);
        }

        .btn-del-sm {
            background: #fff1f1;
            color: #750e13;
        }

        .btn-del-sm:hover {
            background: #c0392b;
            color: #ffffff;
        }

        .empty-msg {
            text-align: center;
            padding: 2rem;
            color: #8d8d8d;
            font-size: 0.9rem;
        }

        .back-link {
            display: inline-block;
            margin-top: 1.5rem;
            padding: 0.75rem 1.5rem;
            background: #f4f4f4;
            color: #525252;
            text-decoration: none;
            border-radius: 4px;
            transition: background 0.2s;
        }

        .back-link:hover {
            background: #e0e0e0;
        }
    </style>
}

<div class="admin-page">
    <div class="page-header" style="background: linear-gradient(135deg, @Model.ColorTheme 0%, #003366 100%);">
        <h1>مدیریت محتوای @Model.Name</h1>
        <p>چالش‌ها، خدمات و نمونه‌کارهای این صنعت را مدیریت کنید</p>
    </div>

    <!-- چالش‌ها -->
    <div class="section-card">
        <div class="section-header">
            <h2>چالش‌ها (@Model.Challenges.Count)</h2>
            <a href="/Admin/AddChallenge?industryId=@Model.Id" class="btn-add">+ افزودن چالش</a>
        </div>
        <div class="section-body">
            @if (Model.Challenges.Any())
            {
                <div class="item-list">
                    @foreach (var c in Model.Challenges)
                    {
                        <div class="item">
                            <div class="item-info">
                                <h4>@c.Title</h4>
                                <p>@c.Description</p>
                            </div>
                            <div class="item-actions">
                                <a href="/Admin/EditChallenge/@c.Id" class="btn-small btn-edit-sm">ویرایش</a>
                                <form method="post" action="/Admin/DeleteChallenge/@c.Id" style="display:inline;" onsubmit="return confirm('حذف شود؟');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-small btn-del-sm">حذف</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-msg">هنوز چالشی اضافه نشده است.</div>
            }
        </div>
    </div>

    <!-- خدمات -->
    <div class="section-card">
        <div class="section-header">
            <h2>خدمات (@Model.Services.Count)</h2>
            <a href="/Admin/AddService?industryId=@Model.Id" class="btn-add">+ افزودن خدمت</a>
        </div>
        <div class="section-body">
            @if (Model.Services.Any())
            {
                <div class="item-list">
                    @foreach (var s in Model.Services)
                    {
                        <div class="item">
                            <div class="item-info">
                                <h4>@s.Title</h4>
                                <p>@s.Description</p>
                            </div>
                            <div class="item-actions">
                                <a href="/Admin/EditService/@s.Id" class="btn-small btn-edit-sm">ویرایش</a>
                                <form method="post" action="/Admin/DeleteService/@s.Id" style="display:inline;" onsubmit="return confirm('حذف شود؟');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-small btn-del-sm">حذف</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-msg">هنوز خدمتی اضافه نشده است.</div>
            }
        </div>
    </div>

    <!-- نمونه‌کارها -->
    <div class="section-card">
        <div class="section-header">
            <h2>نمونه‌کارها (@Model.CaseStudies.Count)</h2>
            <a href="/Admin/AddCaseStudy?industryId=@Model.Id" class="btn-add">+ افزودن نمونه‌کار</a>
        </div>
        <div class="section-body">
            @if (Model.CaseStudies.Any())
            {
                <div class="item-list">
                    @foreach (var cs in Model.CaseStudies)
                    {
                        <div class="item">
                            <div class="item-info">
                                <h4>@cs.Title</h4>
                                <p>@cs.Description</p>
                                @if (!string.IsNullOrEmpty(cs.Result))
                                {
                                    <p style="color: #198038; font-weight: 500; margin-top: 0.25rem;">نتیجه: @cs.Result</p>
                                }
                            </div>
                            <div class="item-actions">
                                <a href="/Admin/EditCaseStudy/@cs.Id" class="btn-small btn-edit-sm">ویرایش</a>
                                <form method="post" action="/Admin/DeleteCaseStudy/@cs.Id" style="display:inline;" onsubmit="return confirm('حذف شود؟');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-small btn-del-sm">حذف</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-msg">هنوز نمونه‌کاری اضافه نشده است.</div>
            }
        </div>
    </div>

    <a href="/Admin/Industries" class="back-link">← بازگشت به لیست صنایع</a>
</div>