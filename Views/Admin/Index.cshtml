@{
    ViewData["Title"] = "داشبورد مدیریت";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .dashboard-container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .dashboard-header {
            margin-bottom: 40px;
        }

        .dashboard-header h1 {
            font-size: 2rem;
            color: #004a99;
            margin-bottom: 10px;
        }

        .dashboard-header p {
            color: #64748b;
            font-size: 1rem;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 50px;
        }

        .stat-card {
            background: #fff;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            border-top: 4px solid #004a99;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        .stat-card.leads { border-top-color: #10b981; }
        .stat-card.industries { border-top-color: #004a99; }
        .stat-card.challenges { border-top-color: #ef4444; }
        .stat-card.services { border-top-color: #f59e0b; }

        .stat-card .label {
            font-size: 0.9rem;
            color: #64748b;
            margin-bottom: 10px;
        }

        .stat-card .value {
            font-size: 2.5rem;
            font-weight: 700;
            color: #1e293b;
        }

        .quick-actions {
            background: #fff;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        .quick-actions h2 {
            font-size: 1.3rem;
            color: #1e293b;
            margin-bottom: 20px;
        }

        .actions-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }

        .action-btn {
            display: block;
            padding: 20px;
            background: #f8fafc;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            text-decoration: none;
            color: #1e293b;
            font-weight: 500;
            text-align: center;
            transition: all 0.2s;
        }

        .action-btn:hover {
            background: #004a99;
            color: #fff;
            border-color: #004a99;
            transform: translateY(-3px);
        }
    </style>
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <h1>داشبورد مدیریت</h1>
        <p>خوش آمدید، @User.Identity!.Name</p>
    </div>

    <!-- کارت‌های آمار -->
    <div class="stats-grid">
        <div class="stat-card leads">
            <div class="label">تعداد سرنخ‌ها (Leads)</div>
            <div class="value">@ViewBag.TotalLeads</div>
        </div>
        <div class="stat-card industries">
            <div class="label">تعداد صنایع</div>
            <div class="value">@ViewBag.TotalIndustries</div>
        </div>
        <div class="stat-card challenges">
            <div class="label">تعداد چالش‌ها</div>
            <div class="value">@ViewBag.TotalChallenges</div>
        </div>
        <div class="stat-card services">
            <div class="label">تعداد خدمات</div>
            <div class="value">@ViewBag.TotalServices</div>
        </div>
    </div>

    <!-- اقدامات سریع -->
    <div class="quick-actions">
        <h2>اقدامات سریع</h2>
        <div class="actions-grid">
            <a href="/Admin/Leads" class="action-btn">مشاهده سرنخ‌ها</a>
            <a href="/Admin/Industries" class="action-btn">مدیریت صنایع</a>
            <a href="/" class="action-btn">مشاهده سایت</a>
        </div>
    </div>
</div>