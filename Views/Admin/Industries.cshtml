@model List<Rasttad.Models.Industry>

@{
    ViewData["Title"] = "مدیریت صنایع";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .admin-page {
            max-width: 1200px;
            margin: 3rem auto;
            padding: 0 1.25rem;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .page-title {
            font-size: 1.75rem;
            font-weight: 700;
            color: #1b1b1b;
        }

        .btn-create {
            padding: 0.75rem 1.5rem;
            background: #198038;
            color: #ffffff;
            text-decoration: none;
            border-radius: 4px;
            font-size: 0.9rem;
            font-weight: 500;
            transition: background 0.2s;
        }

        .btn-create:hover {
            background: #135c28;
        }

        .industry-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 1.5rem;
        }

        .industry-card {
            background: #ffffff;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            overflow: hidden;
            transition: border-color 0.2s;
        }

        .industry-card:hover {
            border-color: var(--rasttad-primary);
        }

        .card-header {
            padding: 1.5rem;
            color: #ffffff;
        }

        .card-header h3 {
            font-size: 1.15rem;
            font-weight: 600;
            margin-bottom: 0.25rem;
        }

        .card-header .slug {
            font-size: 0.8rem;
            opacity: 0.85;
            font-family: monospace;
        }

        .card-body {
            padding: 1.25rem 1.5rem;
        }

        .card-stats {
            display: flex;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .card-stat {
            flex: 1;
            text-align: center;
            padding: 0.75rem;
            background: #f4f4f4;
            border-radius: 4px;
        }

        .card-stat .num {
            font-size: 1.25rem;
            font-weight: 700;
            color: #1b1b1b;
        }

        .card-stat .lbl {
            font-size: 0.75rem;
            color: #6f6f6f;
        }

        .card-actions {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            padding: 0 1.5rem 1.5rem;
        }

        .btn-action {
            padding: 0.6rem 1rem;
            border-radius: 4px;
            font-size: 0.85rem;
            font-family: 'Vazirmatn', sans-serif;
            border: none;
            cursor: pointer;
            text-decoration: none;
            text-align: center;
            transition: all 0.2s;
            font-weight: 500;
        }

        .btn-content {
            background: #198038;
            color: #ffffff;
        }

        .btn-content:hover {
            background: #135c28;
        }

        .btn-edit {
            background: var(--rasttad-primary);
            color: #ffffff;
        }

        .btn-edit:hover {
            background: var(--rasttad-primary-dark);
        }

        .btn-delete {
            background: #fff1f1;
            color: #750e13;
        }

        .btn-delete:hover {
            background: #c0392b;
            color: #ffffff;
        }

        .row-actions {
            display: flex;
            gap: 0.5rem;
        }

        .row-actions .btn-action {
            flex: 1;
        }
    </style>
}

<div class="admin-page">
    <div class="page-header">
        <h1 class="page-title">مدیریت صنایع (@Model.Count)</h1>
        <a href="/Admin/CreateIndustry" class="btn-create">+ افزودن صنعت جدید</a>
    </div>

    <div class="industry-grid">
        @foreach (var industry in Model)
        {
            <div class="industry-card">
                <div class="card-header" style="background: linear-gradient(135deg, @industry.ColorTheme 0%, #003366 100%);">
                    <h3>@industry.Name</h3>
                    <div class="slug">/@industry.Slug</div>
                </div>
                <div class="card-body">
                    <div class="card-stats">
                        <div class="card-stat">
                            <div class="num">@industry.Challenges.Count</div>
                            <div class="lbl">چالش</div>
                        </div>
                        <div class="card-stat">
                            <div class="num">@industry.Services.Count</div>
                            <div class="lbl">خدمت</div>
                        </div>
                        <div class="card-stat">
                            <div class="num">@industry.CaseStudies.Count</div>
                            <div class="lbl">نمونه‌کار</div>
                        </div>
                    </div>
                </div>
                <div class="card-actions">
                    <a href="/Admin/IndustryContent/@industry.Id" class="btn-action btn-content">
                        📝 مدیریت محتوا
                    </a>
                    <div class="row-actions">
                        <a href="/Admin/EditIndustry/@industry.Id" class="btn-action btn-edit">ویرایش</a>
                        <form method="post" action="/Admin/DeleteIndustry/@industry.Id" style="flex:1;" onsubmit="return confirm('مطمئن هستید که می‌خواهید این صنعت را حذف کنید؟ تمام چالش‌ها، خدمات و نمونه‌کارهای مرتبط هم حذف می‌شوند.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-action btn-delete" style="width:100%;">حذف</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>