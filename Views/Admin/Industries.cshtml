@model List<Rasttad.Models.Industry>

@{
    ViewData["Title"] = "مدیریت صنایع";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .admin-container {
            max-width: 1300px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .page-header h1 {
            font-size: 1.8rem;
            color: #004a99;
        }

        .btn-create {
            padding: 12px 30px;
            background: #10b981;
            color: #fff;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 500;
            transition: all 0.2s;
            display: inline-block;
        }

        .btn-create:hover {
            background: #059669;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(16,185,129,0.3);
        }

        .industry-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 20px;
        }

        .industry-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            overflow: hidden;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .industry-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        .card-header {
            padding: 25px;
            color: #fff;
        }

        .card-header h3 {
            font-size: 1.2rem;
            margin-bottom: 5px;
        }

        .card-header .slug {
            font-size: 0.8rem;
            opacity: 0.8;
            font-family: monospace;
        }

        .card-body {
            padding: 20px 25px;
        }

        .card-stats {
            display: flex;
            gap: 15px;
            margin-bottom: 15px;
        }

        .card-stat {
            flex: 1;
            text-align: center;
            padding: 10px;
            background: #f8fafc;
            border-radius: 8px;
        }

        .card-stat .num {
            font-size: 1.3rem;
            font-weight: 700;
            color: #1e293b;
        }

        .card-stat .lbl {
            font-size: 0.75rem;
            color: #64748b;
        }

        .card-actions {
            display: flex;
            gap: 8px;
            padding: 0 25px 25px;
        }

        .btn-action {
            flex: 1;
            padding: 10px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-family: inherit;
            border: none;
            cursor: pointer;
            text-decoration: none;
            text-align: center;
            transition: all 0.2s;
            font-weight: 500;
        }

        .btn-edit {
            background: #004a99;
            color: #fff;
        }

        .btn-edit:hover {
            background: #003366;
        }

        .btn-delete {
            background: #fee2e2;
            color: #991b1b;
        }

        .btn-delete:hover {
            background: #ef4444;
            color: #fff;
        }
    </style>
}

<div class="admin-container">
    <div class="page-header">
        <h1>مدیریت صنایع (@Model.Count)</h1>
        <a href="/Admin/CreateIndustry" class="btn-create">+ افزودن صنعت جدید</a>
    </div>

    <div class="industry-grid">
        @foreach (var industry in Model)
        {
            <div class="industry-card">
                <div class="card-header" style="background: linear-gradient(135deg, @industry.ColorTheme 0%, #003366 100%);">
                    <h3>@industry.Name</h3>
                    <div class="slug">/@industry.Slug</div>
                </div>
                <div class="card-body">
                    <div class="card-stats">
                        <div class="card-stat">
                            <div class="num">@industry.Challenges.Count</div>
                            <div class="lbl">چالش</div>
                        </div>
                        <div class="card-stat">
                            <div class="num">@industry.Services.Count</div>
                            <div class="lbl">خدمت</div>
                        </div>
                        <div class="card-stat">
                            <div class="num">@industry.CaseStudies.Count</div>
                            <div class="lbl">نمونه‌کار</div>
                        </div>
                    </div>
                </div>
                <div class="card-actions">
                    <a href="/Admin/EditIndustry/@industry.Id" class="btn-action btn-edit">ویرایش</a>
                    <form method="post" action="/Admin/DeleteIndustry/@industry.Id" style="flex:1;" onsubmit="return confirm('مطمئن هستید که می‌خواهید این صنعت را حذف کنید؟ تمام چالش‌ها، خدمات و نمونه‌کارهای مرتبط هم حذف می‌شوند.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-action btn-delete" style="width:100%;">حذف</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>