@{
    ViewData["Title"] = "سرای توسعه انسانی";
}

@section Styles {
    <style>
        /* ==================== Hero Section ==================== */
        .hero-video-section {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 7rem 0 5rem;
            overflow: hidden;
            background: #0a1628;
        }

        .hero-video {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 1;
        }

        /* گرادیانت تیره به سفید */
        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 2;
            background: linear-gradient(
                to bottom,
                rgba(10, 22, 40, 0.85) 0%,
                rgba(10, 22, 40, 0.65) 35%,
                rgba(10, 22, 40, 0.45) 60%,
                rgba(255, 255, 255, 0.7) 88%,
                rgba(255, 255, 255, 1) 100%
            );
        }

        .hero-content {
            position: relative;
            z-index: 3;
            max-width: 1050px;
            margin: 0 auto;
            padding: 0 1.5rem;
            text-align: center;
            color: #ffffff;
            width: 100%;
        }

        /* ==================== Hero Logo ==================== */
        .hero-logo {
            margin-bottom: 2.5rem;
            animation: fadeInDown 0.8s ease-out;
        }

        .hero-logo img {
            max-width: 200px;
            height: auto;
            filter: brightness(0) invert(1) drop-shadow(0 4px 12px rgba(0,0,0,0.3));
        }

        /* ==================== Hero Badge ==================== */
        .hero-badge {
            display: inline-block;
            padding: 0.5rem 1.25rem;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 500;
            color: #ffffff;
            letter-spacing: 0.5px;
            margin-bottom: 1.75rem;
            animation: fadeInUp 0.8s ease-out 0.1s both;
        }

        .hero-badge::before {
            content: '●';
            color: #4ade80;
            margin-left: 0.5rem;
            font-size: 0.7rem;
            animation: pulse 2s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }

        /* ==================== Hero Title ==================== */
        .hero-content h1 {
            color: #ffffff;
            font-size: clamp(1.85rem, 4.5vw, 3rem);
            font-weight: 800;
            margin-bottom: 1.25rem;
            line-height: 1.35;
            letter-spacing: -0.02em;
            text-shadow: 0 4px 24px rgba(0,0,0,0.5);
            animation: fadeInUp 0.8s ease-out 0.2s both;
        }

        .hero-content h1 .highlight {
            background: linear-gradient(135deg, #ffffff 0%, #c7d9f0 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-content p {
            color: rgba(255,255,255,0.92);
            font-size: clamp(0.95rem, 1.8vw, 1.1rem);
            max-width: 620px;
            margin: 0 auto 3rem;
            line-height: 1.8;
            text-shadow: 0 2px 12px rgba(0,0,0,0.4);
            animation: fadeInUp 0.8s ease-out 0.3s both;
        }

        /* ==================== Gateway Form (شیشه‌ای) ==================== */
        .gateway-form {
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 16px;
            padding: 2.5rem;
            box-shadow: 
                0 25px 60px rgba(0, 0, 0, 0.35),
                inset 0 1px 0 rgba(255, 255, 255, 0.2);
            max-width: 1050px;
            margin: 0 auto;
            animation: fadeInUp 0.8s ease-out 0.4s both;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr auto;
            gap: 1.25rem;
            align-items: end;
        }

        .form-field-wrap {
            display: flex;
            flex-direction: column;
            text-align: right;
        }

        .form-field-wrap label {
            font-size: 0.8rem;
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 0.6rem;
            font-family: 'Vazirmatn', sans-serif;
            text-shadow: 0 1px 4px rgba(0,0,0,0.3);
            letter-spacing: 0.3px;
        }

        .form-field-wrap select {
            width: 100%;
            padding: 0.85rem 1rem;
            font-family: 'Vazirmatn', sans-serif;
            font-size: 0.9rem;
            color: #1b1b1b;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 8px;
            outline: none;
            cursor: pointer;
            transition: all 0.25s ease;
            direction: rtl;
            appearance: none;
            background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2212%22%20height%3D%2212%22%20viewBox%3D%220%200%2012%2012%22%3E%3Cpath%20fill%3D%22%23767676%22%20d%3D%22M6%209L1%204h10z%22%2F%3E%3C%2Fsvg%3E");
            background-repeat: no-repeat;
            background-position: left 16px center;
            padding-left: 40px;
            font-weight: 500;
        }

        .form-field-wrap select:hover {
            background: #ffffff;
            border-color: rgba(255, 255, 255, 0.8);
        }

        .form-field-wrap select:focus {
            border-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.3);
            background: #ffffff;
        }

        .form-submit-btn {
            padding: 0.85rem 2.25rem;
            background: linear-gradient(135deg, #2557a7 0%, #1a3f7a 100%);
            color: #ffffff;
            border: none;
            border-radius: 8px;
            font-family: 'Vazirmatn', sans-serif;
            font-size: 0.95rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.25s ease;
            white-space: nowrap;
            height: 48px;
            box-shadow: 0 4px 16px rgba(37, 87, 167, 0.4);
            letter-spacing: 0.3px;
        }

        .form-submit-btn:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(37, 87, 167, 0.6);
            background: linear-gradient(135deg, #1a3f7a 0%, #0f2a54 100%);
        }

        .form-submit-btn:disabled {
            background: rgba(255, 255, 255, 0.2);
            color: rgba(255, 255, 255, 0.5);
            cursor: not-allowed;
            box-shadow: none;
            backdrop-filter: blur(10px);
        }

        /* ==================== Animations ==================== */
        @@keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ==================== Trust Section ==================== */
        .trust-section {
            padding: 5rem 0;
            text-align: center;
            background: #ffffff;
            position: relative;
            z-index: 5;
            margin-top: -1px;
        }

        .trust-section p {
            font-size: 0.8rem;
            color: #8d8d8d;
            margin-bottom: 2rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 500;
        }

        .trust-logos {
            display: flex;
            justify-content: center;
            gap: 3.5rem;
            flex-wrap: wrap;
            opacity: 0.4;
        }

        .trust-logos span {
            font-size: 1.05rem;
            font-weight: 700;
            color: #525252;
            letter-spacing: -0.5px;
        }

        /* ==================== Responsive ==================== */
        @@media (max-width: 900px) {
            .form-grid {
                grid-template-columns: 1fr;
            }
            .form-submit-btn {
                width: 100%;
            }
        }

        @@media (max-width: 600px) {
            .hero-video-section { 
                min-height: 90vh; 
                padding: 5rem 0 3rem; 
            }
            .gateway-form { 
                padding: 1.5rem 1.25rem; 
                border-radius: 12px;
            }
            .hero-logo img { max-width: 140px; }
            .hero-content h1 { font-size: 1.5rem; }
            .hero-content p { font-size: 0.9rem; }
        }
    </style>
}

<!-- ==================== Hero with Video Background ==================== -->
<section class="hero-video-section">

    <video class="hero-video" 
           autoplay 
           muted 
           loop 
           playsinline 
           preload="auto"
           poster="/images/hero-poster.jpg">
        <source src="/videos/hero-bg.mp4" type="video/mp4" />
        <source src="/videos/hero-bg.webm" type="video/webm" />
    </video>

    <!-- گرادیانت تیره به سفید -->
    <div class="hero-overlay"></div>

    <div class="hero-content">
        <!-- لوگو -->
        <div class="hero-logo">
            <img src="/images/logo.png" alt="رستاد">
        </div>

        <!-- بج معرفی -->
        <div class="hero-badge">
            اولین بوتیک  تخصصی توسعه کسب‌وکار
        </div>

        <!-- تیتر اصلی -->
        <h1>
            <span class="highlight">توسعه کسب‌وکار</span> و سرمایه‌های انسانی<br />
            متناسب با صنعت شما
        </h1>

        <!-- توضیحات -->
        <p>
            با پاسخ به فرم زیر، وارد سکوی تخصصی کسب‌وکار خود شوید و راهکارهای اختصاصی رستاد را دریافت کنید.
        </p>

        <!-- فرم Gateway -->
        <div class="gateway-form">
            <form asp-controller="Industry" asp-action="Details" method="get">
                <div class="form-grid">
                    <div class="form-field-wrap">
                        <label for="slug">نام صنعت</label>
                        <select id="slug" name="slug" required onchange="checkForm()">
                            <option value="" disabled selected>انتخاب کنید</option>
                            <option value="it">فناوری اطلاعات و استارتاپ</option>
                            <option value="manufacturing">تولید و صنایع</option>
                            <option value="retail">خرده‌فروشی و زنجیره‌ای</option>
                            <option value="finance">خدمات مالی و بانکی</option>
                            <option value="health">سلامت و درمان</option>
                            <option value="construction">عمران و ساختمان</option>
                            <option value="hospitality">خدمات و مهمان‌نوازی</option>
                            <option value="logistics">بازرگانی و لجستیک</option>
                        </select>
                    </div>

                    <div class="form-field-wrap">
                        <label for="employees">تعداد کارکنان</label>
                        <select id="employees" name="employees" required onchange="checkForm()">
                            <option value="" disabled selected>انتخاب کنید</option>
                            <option value="1-10">۱ تا ۱۰ نفر</option>
                            <option value="11-50">۱۱ تا ۵۰ نفر</option>
                            <option value="51-200">۵۱ تا ۲۰۰ نفر</option>
                            <option value="201-500">۲۰۱ تا ۵۰۰ نفر</option>
                            <option value="500+">بیش از ۵۰۰ نفر</option>
                        </select>
                    </div>

                    <div class="form-field-wrap">
                        <label for="location">محل فعالیت</label>
                        <select id="location" name="location" required onchange="checkForm()">
                            <option value="" disabled selected>انتخاب کنید</option>
                            <option value="tehran">تهران</option>
                            <option value="isfahan">اصفهان</option>
                            <option value="mashhad">مشهد</option>
                            <option value="shiraz">شیراز</option>
                            <option value="tabriz">تبریز</option>
                            <option value="other">سایر شهرها</option>
                        </select>
                    </div>

                    <div>
                        <button type="submit" id="submitBtn" class="form-submit-btn" disabled>ورود به سکو</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

</section>

<!-- ==================== Trust Section ==================== -->
<section class="trust-section">
    <div class="grid-container">
        <p>مورد اعتماد کسب‌وکارهای پیشرو</p>
        <div class="trust-logos">
            <span>شرکت الف</span>
            <span>استارتاپ ب</span>
            <span>گروه ج</span>
            <span>هلدینگ د</span>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // پخش خودکار ویدیو
        document.addEventListener('DOMContentLoaded', function() {
            const video = document.querySelector('.hero-video');
            if (video) {
                video.play().catch(function(error) {
                    console.log('Autoplay was prevented:', error);
                });
            }
        });

        function checkForm() {
            const slug = document.getElementById('slug').value;
            const employees = document.getElementById('employees').value;
            const location = document.getElementById('location').value;
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = !(slug && employees && location);
        }
    </script>
}