@{
    ViewData["Title"] = "سرای توسعه انسانی";
}

@section Styles {
    <style>
        .gateway-hero {
            padding: 6rem 0 5rem;
            text-align: center;
            border-bottom: 1px solid #e0e0e0;
            background-color: #f8f9fa;
        }

        .gateway-hero .hero-logo {
            margin-bottom: 3rem;
        }

        .gateway-hero .hero-logo img {
            max-width: 200px;
            height: auto;
        }

        .gateway-hero h1 {
            font-size: clamp(1.75rem, 4vw, 2.5rem);
            font-weight: 700;
            color: #1b1b1b;
            margin-bottom: 1rem;
            line-height: 1.3;
        }

        .gateway-hero p {
            font-size: 1.05rem;
            color: #525252;
            max-width: 600px;
            margin: 0 auto 3rem;
        }

        .gateway-form {
            max-width: 1000px;
            margin: 0 auto;
            background: #ffffff;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 2.5rem;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr auto;
            gap: 1.25rem;
            align-items: end;
        }

        .form-field-wrap {
            display: flex;
            flex-direction: column;
            text-align: right;
        }

        .form-field-wrap label {
            font-size: 0.85rem;
            font-weight: 500;
            color: #1b1b1b;
            margin-bottom: 0.5rem;
            font-family: 'Vazirmatn', sans-serif;
        }

        .form-field-wrap select {
            width: 100%;
            padding: 0.75rem 1rem;
            font-family: 'Vazirmatn', sans-serif;
            font-size: 0.9rem;
            color: #1b1b1b;
            background: #ffffff;
            border: 1px solid #c6c6c6;
            border-radius: 4px;
            outline: none;
            cursor: pointer;
            transition: border-color 0.2s;
            direction: rtl;
            appearance: none;
            background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2212%22%20height%3D%2212%22%20viewBox%3D%220%200%2012%2012%22%3E%3Cpath%20fill%3D%22%23767676%22%20d%3D%22M6%209L1%204h10z%22%2F%3E%3C%2Fsvg%3E");
            background-repeat: no-repeat;
            background-position: left 16px center;
            padding-left: 40px;
        }

        .form-field-wrap select:focus {
            border-color: var(--rasttad-primary);
            box-shadow: 0 0 0 2px var(--rasttad-primary-light);
        }

        .form-submit-btn {
            padding: 0.75rem 2rem;
            background: var(--rasttad-primary);
            color: #ffffff;
            border: none;
            border-radius: 4px;
            font-family: 'Vazirmatn', sans-serif;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s;
            white-space: nowrap;
            height: 46px;
        }

        .form-submit-btn:hover:not(:disabled) {
            background: var(--rasttad-primary-dark);
        }

        .form-submit-btn:disabled {
            background: #e0e0e0;
            color: #8d8d8d;
            cursor: not-allowed;
        }

        .trust-section {
            padding: 4rem 0;
            text-align: center;
        }

        .trust-section p {
            font-size: 0.85rem;
            color: #6f6f6f;
            margin-bottom: 1.5rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .trust-logos {
            display: flex;
            justify-content: center;
            gap: 3rem;
            flex-wrap: wrap;
            opacity: 0.5;
        }

        .trust-logos span {
            font-size: 1rem;
            font-weight: 600;
            color: #525252;
        }

        @@media (max-width: 900px) {
            .form-grid {
                grid-template-columns: 1fr;
            }
            .form-submit-btn {
                width: 100%;
            }
        }

        @@media (max-width: 600px) {
            .gateway-hero { padding: 3rem 0 2.5rem; }
            .gateway-form { padding: 1.5rem 1.25rem; }
        }
    </style>
}

<section class="gateway-hero">
    <div class="grid-container">
        <div class="hero-logo">
            <img src="~/images/logo.png" alt="رستاد">
        </div>
        <h1>راهکارهای تخصصی منابع انسانی<br />متناسب با صنعت شما</h1>
        <p>صنعت، اندازه و موقعیت کسب‌وکار خود را انتخاب کنید تا راهکارهای اختصاصی رستاد را ببینید.</p>

        <div class="gateway-form">
            <form asp-controller="Industry" asp-action="Details" method="get">
                <div class="form-grid">
                    <div class="form-field-wrap">
                        <label for="slug">نام صنعت</label>
                        <select id="slug" name="slug" required onchange="checkForm()">
                            <option value="" disabled selected>انتخاب کنید</option>
                            <option value="it">فناوری اطلاعات و استارتاپ</option>
                            <option value="manufacturing">تولید و صنایع</option>
                            <option value="retail">خرده‌فروشی و زنجیره‌ای</option>
                            <option value="finance">خدمات مالی و بانکی</option>
                            <option value="health">سلامت و درمان</option>
                            <option value="construction">عمران و ساختمان</option>
                            <option value="hospitality">خدمات و مهمان‌نوازی</option>
                            <option value="logistics">بازرگانی و لجستیک</option>
                        </select>
                    </div>

                    <div class="form-field-wrap">
                        <label for="employees">تعداد کارکنان</label>
                        <select id="employees" name="employees" required onchange="checkForm()">
                            <option value="" disabled selected>انتخاب کنید</option>
                            <option value="1-10">۱ تا ۱۰ نفر</option>
                            <option value="11-50">۱۱ تا ۵۰ نفر</option>
                            <option value="51-200">۵۱ تا ۲۰۰ نفر</option>
                            <option value="201-500">۲۰۱ تا ۵۰۰ نفر</option>
                            <option value="500+">بیش از ۵۰۰ نفر</option>
                        </select>
                    </div>

                    <div class="form-field-wrap">
                        <label for="location">محل فعالیت</label>
                        <select id="location" name="location" required onchange="checkForm()">
                            <option value="" disabled selected>انتخاب کنید</option>
                            <option value="tehran">تهران</option>
                            <option value="isfahan">اصفهان</option>
                            <option value="mashhad">مشهد</option>
                            <option value="shiraz">شیراز</option>
                            <option value="tabriz">تبریز</option>
                            <option value="other">سایر شهرها</option>
                        </select>
                    </div>

                    <div>
                        <button type="submit" id="submitBtn" class="form-submit-btn" disabled>مشاهده راهکارها</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

<section class="trust-section">
    <div class="grid-container">
        <p>مورد اعتماد کسب‌وکارهای پیشرو</p>
        <div class="trust-logos">
            <span>شرکت الف</span>
            <span>استارتاپ ب</span>
            <span>گروه ج</span>
            <span>هلدینگ د</span>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function checkForm() {
            const slug = document.getElementById('slug').value;
            const employees = document.getElementById('employees').value;
            const location = document.getElementById('location').value;
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = !(slug && employees && location);
        }
    </script>
}